{
  "rule_id": "ammonium_enriched_v1",
  "rule_version": "1.0",
  "semantic_type": "ammonium_enriched_layer",
  "variables": [
    {
      "name": "NHX",
      "operator": ">",
      "threshold_type": "percentile",
      "threshold": 90,
      "percentile_scope": "global",
      "unit": "mg/L"
    }
  ],
  "logic": "AND",
  "vertical_constraints": {
    "min_continuous_layers": 1,
    "min_thickness": 0.0
  },
  "depth_reference": "surface",
  "output_attributes": ["occurrence", "z_top", "z_bottom", "thickness", "core_depth", "segment_count", "layer_start", "layer_end"],
  "metadata": {
    "description": "Ammonium enriched layer based on global P90 threshold; users may switch to an absolute threshold"
  }
}
